<?xml version="1.0" ?>
<!-- ============================================================================== -->
<!-- Civil Architectural Engineering Building Simulation World (Gazebo Harmonic)   -->
<!-- Compatible with ROS 2 Jazzy & AgileX Scout Mini AMR Autonomous Navigation     -->
<!-- Reference: NIST Standard Civil Facility / Architectural Multi-Room Benchmark  -->
<!-- ============================================================================== -->
<sdf version="1.8">
  <world name="amr_world">
    <physics name="10ms" type="ignored">
      <max_step_size>0.010</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 2 15 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Civil Floor Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.85 0.88 1</ambient>
            <diffuse>0.82 0.85 0.88 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_ext_north">
      <static>true</static>
      <pose>0.000 8.000 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>20.200 0.200 1.200</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>20.200 0.200 1.200</size></box></geometry>
          <material>
            <ambient>0.28 0.32 0.38 1</ambient>
            <diffuse>0.28 0.32 0.38 1</diffuse>
